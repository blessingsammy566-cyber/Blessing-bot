@app.route("/whatsapp", methods=['POST'])
def whatsapp_bot():
    incoming_msg = request.values.get('Body', '')
    resp = MessagingResponse()
    if not incoming_msg:  
        return str(MessagingResponse().message("I can only reply to text messages for now."))
    msg = resp.message()
    msg.body(auto_reply(incoming_msg))
    return str(resp)
